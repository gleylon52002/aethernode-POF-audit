{
  "name": "aethernode-secure-browser",
  "version": "1.0.3",
  "description": "AetherNode Secure Browser — privacy-first desktop browser.",
  "author": "AetherNode",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win --x64",
    "dist:secure": "vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "adm-zip": "^0.6.0",
    "argon2": "^0.41.1",
    "basic-ftp": "^6.2.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "framer-motion": "^11.5.4",
    "lucide-react": "^0.439.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.aethernode.browser",
    "productName": "AetherNode POF",
    "copyright": "Copyright © AetherNode",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "afterPack": "./scripts/after-pack.js",
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "resources/**/*",
      "logo.png"
    ],
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "icons"
      }
    ],
    "asarUnpack": [
      "**/*.{node,dll}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon.ico",
      "artifactName": "${productName}-v${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icons/icon.ico",
      "uninstallerIcon": "resources/icons/icon.ico",
      "installerHeaderIcon": "resources/icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AetherNode POF"
    },
    "portable": {
      "artifactName": "${productName}-v${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icons/icon.ico"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://aethernodevpn.com/POF/updates/"
      }
    ]
  }
}
